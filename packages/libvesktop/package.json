{
    "name": "libvesktop",
    "version": "0.1.0",
    "main": "index.js",
    "types": "index.d.ts",
    "napi": {
        "binaryName": "vesktop",
        "targets": ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-gnu"]
    },
    "devDependencies": {
        "@napi-rs/cli": "^3.9.0"
    },
    "scripts": {
        "build": "cargo build --release --lib",
        "build:cross": "./build.sh",
        "build:debug": "cargo build --lib",
        "clean": "rm -rf target *.node index.js",
        "test": "pnpm run build:debug && node --test test.js"
    }
}
